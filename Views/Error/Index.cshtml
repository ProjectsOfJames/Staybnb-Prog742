@{
    ViewData["Title"] = (string)ViewData["Heading"]!;
}

<div class="container py-5 text-center" style="max-width:560px">
    <div class="display-3 fw-bold" style="color:var(--sb-primary)">@ViewData["Code"]</div>
    <h1 class="h4 fw-bold mt-2">@ViewData["Heading"]</h1>
    <p class="text-muted">@ViewData["Message"]</p>
    <a href="/" class="btn btn-danger">Go home</a>
</div>