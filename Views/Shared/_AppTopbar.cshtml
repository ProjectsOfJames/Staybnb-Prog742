<header class="sb-topbar">
    <button type="button" class="sb-icon-btn" data-sb-toggle aria-label="Toggle sidebar">
        <i class="bi bi-list"></i>
    </button>
    <h1 class="sb-page-title">@ViewData["Title"]</h1>
    <div class="d-flex align-items-center gap-2">
        @await Component.InvokeAsync("UnreadMessages")
        @await Component.InvokeAsync("NotificationBell")
        <partial name="_UserMenu" />
    </div>
</header>