@model List<ConversationRowVM>
@{
    ViewData["Title"] = "Messages";
}

<div class="container py-4" style="max-width:820px">
    <h1 class="h3 fw-bold mb-3">Messages</h1>
    <partial name="_Alerts" />

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-chat-dots fs-1"></i>
            <p class="mt-2 mb-1">No messages yet.</p>
            <p class="small">Use <strong>Message host</strong> on a property or booking page to start a conversation.</p>
        </div>
    }
    else
    {
        <div class="sb-panel p-0 overflow-hidden">
            @foreach (var c in Model)
            {
                var initial = string.IsNullOrWhiteSpace(c.OtherName) ? "?" : c.OtherName.Trim()[0].ToString().ToUpper();
                var local = c.LastTimestamp.ToLocalTime();
                var when = local.Date == DateTime.Today ? local.ToString("HH:mm") : local.ToString("dd MMM");

                <a href="/Messages/Conversation/@c.OtherUserId"
                   class="d-flex align-items-center gap-3 p-3 border-bottom text-decoration-none @(c.UnreadCount > 0 ? "bg-light" : "")">
                    <span class="sb-avatar" style="width:44px;height:44px">@initial</span>
                    <div class="flex-grow-1" style="min-width:0">
                        <div class="d-flex justify-content-between">
                            <span class="@(c.UnreadCount > 0 ? "fw-bold" : "fw-semibold")">
                                @c.OtherName <span class="sb-badge sb-badge-neutral ms-1">@c.OtherRole</span>
                            </span>
                            <span class="small text-muted">@when</span>
                        </div>
                        <div class="small text-truncate @(c.UnreadCount > 0 ? "fw-semibold" : "text-muted")">
                            @(c.LastIsMine ? "You: " : "")@c.Preview
                        </div>
                    </div>
                    @if (c.UnreadCount > 0)
                    {
                        <span class="sb-badge" style="background:var(--sb-primary);color:#fff">@c.UnreadCount</span>
                    }
                </a>
            }
        </div>
    }
</div>