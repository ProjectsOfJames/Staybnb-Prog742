@model ConversationVM
@{
    ViewData["Title"] = "Chat with " + Model.OtherName;
    var initial = string.IsNullOrWhiteSpace(Model.OtherName) ? "?" : Model.OtherName.Trim()[0].ToString().ToUpper();
    DateTime? lastDay = null;
}

<div class="container py-4" style="max-width:820px">
    <a href="/Messages" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> All messages</a>

    <div class="d-flex align-items-center gap-3 my-3">
        <span class="sb-avatar" style="width:44px;height:44px">@initial</span>
        <div>
            <div class="fw-semibold">@Model.OtherName</div>
            <span class="sb-badge sb-badge-neutral">@Model.OtherRole</span>
        </div>
    </div>

    <partial name="_Alerts" />

    <div class="sb-panel">
        <div id="thread" class="d-flex flex-column gap-2 mb-3" style="max-height:55vh;overflow-y:auto">
            @if (!Model.Messages.Any())
            {
                <div class="text-center text-muted py-4">
                    <i class="bi bi-chat-dots fs-2"></i>
                    <p class="mt-2 mb-0">No messages yet. Say hello below.</p>
                </div>
            }

            @foreach (var m in Model.Messages)
            {
                var local = m.Timestamp.ToLocalTime();
                if (lastDay != local.Date)
                {
                    lastDay = local.Date;
                    <div class="text-center small text-muted my-1">@local.ToString("dddd, dd MMM yyyy")</div>
                }

                <div class="d-flex @(m.IsMine ? "justify-content-end" : "justify-content-start")">
                    <div class="px-3 py-2 rounded-4"
                         style="max-width:75%;white-space:pre-wrap;word-break:break-word;@(m.IsMine ? "background:var(--sb-primary);color:#fff" : "background:#f0f0f0")">
                        @m.Content<div class="small mt-1" style="opacity:.75;font-size:.7rem">@local.ToString("HH:mm")@(m.IsMine && m.IsRead ? " · Seen" : "")</div>
                    </div>
                </div>
            }
        </div>

        <form asp-action="Send" asp-route-id="@Model.OtherUserId" method="post">
            <div class="d-flex gap-2 align-items-end">
                <textarea name="content" class="form-control" rows="2" maxlength="2000" required placeholder="Write a message..."></textarea>
                <button type="submit" class="btn btn-danger"><i class="bi bi-send"></i></button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        var thread = document.getElementById('thread');
        if (thread) { thread.scrollTop = thread.scrollHeight; }
    </script>
}