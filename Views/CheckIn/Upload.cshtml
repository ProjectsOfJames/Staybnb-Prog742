@model CheckInUploadVM
@{
    ViewData["Title"] = "Check-in: document";
}

<div class="container py-4" style="max-width:760px">
    <a href="/Bookings/Details/@Model.BookingId" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Back to booking</a>
    <h1 class="h4 fw-bold mt-2">Check in to @Model.PropertyTitle</h1>
    <partial name="_Alerts" />
    <partial name="_CheckInProgress" model="2" />

    <div class="sb-panel mb-3">
        <h2 class="h6 fw-bold">Upload your ID or passport</h2>
        <p class="small text-muted">Your host will use this to verify who is staying. Only you and your host can see it.</p>

        <form asp-action="Upload" asp-route-id="@Model.BookingId" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="DocumentType" class="form-label"></label>
                <select asp-for="DocumentType" asp-items="@(new SelectList(new[] { "ID", "Passport" }, Model.DocumentType))" class="form-select"></select>
                <span asp-validation-for="DocumentType" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="File" class="form-label"></label>
                <input asp-for="File" type="file" class="form-control" accept=".jpg,.jpeg,.png,.pdf" />
                <span asp-validation-for="File" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-danger">Upload</button>
        </form>
    </div>

    @if (Model.Documents.Any())
    {
        <div class="sb-panel">
            <h2 class="h6 fw-bold">Already uploaded</h2>
            @foreach (var d in Model.Documents)
            {
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <span>@d.DocumentType</span>
                    <span class="d-flex align-items-center gap-3">
                        <partial name="_StatusBadge" model="d.Status.ToString()" />
                        <a href="/CheckIn/Download/@d.Id" target="_blank" class="small">View</a>
                    </span>
                </div>
            }
            <a href="/CheckIn/Confirm/@Model.BookingId" class="btn btn-outline-danger btn-sm mt-3">Continue to review</a>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}