@using System.Globalization
@model GuestBookingVM
@{
    ViewData["Title"] = "Booking #" + Model.Id;
    var rand = CultureInfo.GetCultureInfo("en-ZA");
}

<div class="container-xxl py-4" style="max-width:960px">
    <a href="/Bookings" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> My bookings</a>
    <partial name="_Alerts" />

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2 mb-3">
        <h1 class="h3 fw-bold mb-0">@Model.PropertyTitle</h1>
        <partial name="_StatusBadge" model="Model.Status.ToString()" />
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="sb-panel mb-3">
                @if (Model.ImageUrl != null)
                {
                    <img src="@Model.ImageUrl" alt="@Model.PropertyTitle" class="w-100 rounded-3 mb-3" style="height:260px;object-fit:cover" />
                }
                <div class="row small g-3">
                    <div class="col-6"><div class="text-muted">Check-in</div><div class="fw-semibold">@Model.CheckInDate.ToString("ddd, dd MMM yyyy")</div></div>
                    <div class="col-6"><div class="text-muted">Checkout</div><div class="fw-semibold">@Model.CheckOutDate.ToString("ddd, dd MMM yyyy")</div></div>
                    <div class="col-6"><div class="text-muted">Guests</div><div class="fw-semibold">@Model.NumberOfGuests</div></div>
                    <div class="col-6">
                        <div class="text-muted">Host</div>
                        <div class="fw-semibold">@Model.HostName <a href="/Messages/Conversation/@Model.HostId" class="small ms-1">Message</a></div>
                    </div>
                    <div class="col-12"><div class="text-muted">Address</div><div class="fw-semibold">@Model.Address, @Model.City</div></div>
                </div>
            </div>

            @if (Model.CanCheckIn)
            {
                <div class="sb-panel">
                    <h2 class="h6 fw-bold">Guest check-in</h2>
                    <p class="small text-muted">Your booking is approved. Complete check-in so your host can verify your ID before you arrive.</p>
                    @if (Model.CheckInStatus.HasValue)
                    {
                        <div class="mb-2"><partial name="_StatusBadge" model="Model.CheckInStatus.Value.ToString()" /></div>
                    }
                    <a href="/CheckIn/Rules/@Model.Id" class="btn btn-danger btn-sm">
                        @(Model.CheckInStatus.HasValue ? "Continue check-in" : "Start check-in")
                    </a>
                </div>
            }
            else if (Model.Status == BookingStatus.Pending)
            {
                <div class="alert alert-warning mb-0">Waiting for the host to approve your request. Check-in opens once it is approved.</div>
            }
        </div>

        <div class="col-lg-5">
            <div class="sb-panel">
                <h2 class="h6 fw-bold mb-3">Price details</h2>
                <div class="small">
                    <div class="d-flex justify-content-between"><span>@Model.Nights night(s)</span><span>@Model.StaySubtotal.ToString("C2", rand)</span></div>
                    <div class="d-flex justify-content-between"><span>Cleaning fee</span><span>@Model.CleaningFee.ToString("C2", rand)</span></div>
                    <div class="d-flex justify-content-between"><span>Service fee</span><span>@Model.ServiceFee.ToString("C2", rand)</span></div>
                    <hr />
                    <div class="d-flex justify-content-between fw-bold fs-6"><span>Total</span><span>@Model.TotalPrice.ToString("C2", rand)</span></div>
                </div>

                @if (Model.CanCancel)
                {
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="mt-3"
                          onsubmit="return confirm('Cancel this booking?');">
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">Cancel booking</button>
                    </form>
                }
            </div>
            <div class="text-muted small mt-2">Requested on @Model.CreatedAt.ToString("dd MMM yyyy")</div>
        </div>
    </div>
</div>