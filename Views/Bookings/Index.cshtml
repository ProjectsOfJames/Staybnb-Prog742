@using System.Globalization
@model List<GuestBookingVM>
@{
    ViewData["Title"] = "My bookings";
    var rand = CultureInfo.GetCultureInfo("en-ZA");
}

<div class="container-xxl py-4">
    <h1 class="h3 fw-bold mb-3">My bookings</h1>
    <partial name="_Alerts" />

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-calendar-x fs-1"></i>
            <p class="mt-2">You haven't booked anything yet.</p>
            <a href="/Properties" class="btn btn-danger">Explore stays</a>
        </div>
    }
    else
    {
        @foreach (var b in Model)
        {
            <div class="sb-panel mb-3">
                <div class="row g-3 align-items-center">
                    <div class="col-12 col-md-3 col-lg-2">
                        @if (b.ImageUrl != null)
                        {
                            <img src="@b.ImageUrl" alt="@b.PropertyTitle" class="w-100 rounded-3" style="height:100px;object-fit:cover" />
                        }
                    </div>
                    <div class="col">
                        <div class="fw-semibold">@b.PropertyTitle</div>
                        <div class="small text-muted"><i class="bi bi-geo-alt-fill"></i> @b.City</div>
                        <div class="small mt-1">
                            @b.CheckInDate.ToString("dd MMM") &ndash; @b.CheckOutDate.ToString("dd MMM yyyy")
                            &middot; @b.Nights night(s) &middot; @b.NumberOfGuests guest(s)
                        </div>
                        <div class="mt-2 d-flex flex-wrap gap-2 align-items-center">
                            <partial name="_StatusBadge" model="b.Status.ToString()" />
                            @if (b.CheckInStatus.HasValue)
                            {
                                <span class="small text-muted">Check-in:</span>
                                <partial name="_StatusBadge" model="b.CheckInStatus.Value.ToString()" />
                            }
                        </div>
                    </div>
                    <div class="col-12 col-lg-auto text-lg-end">
                        <div class="fw-bold mb-2">@b.TotalPrice.ToString("C0", rand)</div>
                        <a href="/Bookings/Details/@b.Id" class="btn btn-sm btn-outline-secondary">View</a>
                        @if (b.CanCheckIn)
                        {
                            <a href="/CheckIn/Rules/@b.Id" class="btn btn-sm btn-danger">Check in</a>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>