@model List<HostApplicationStatusRowVM>
@{
    ViewData["Title"] = "Host application status";
}

<div class="container py-5" style="max-width:820px">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 fw-bold mb-0">Host application status</h1>
        <a href="/HostApplication/Create" class="btn btn-danger btn-sm">Apply with a property</a>
    </div>
    <partial name="_Alerts" />

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-house-add fs-1"></i>
            <p class="mt-2">You haven't applied to host yet.</p>
        </div>
    }
    else
    {
        @foreach (var a in Model)
        {
            <div class="sb-panel mb-3">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <div class="fw-semibold">@a.PropertyTitle</div>
                        <div class="small text-muted"><i class="bi bi-geo-alt-fill"></i> @a.City</div>
                        <div class="small text-muted mt-1">Applied @a.AppliedAt.ToString("dd MMM yyyy")</div>
                    </div>
                    <partial name="_StatusBadge" model="a.Status.ToString()" />
                </div>

                @if (a.Status == ApplicationStatus.Pending)
                {
                    <div class="small text-muted mt-2">An admin is reviewing your application.</div>
                }
                else if (a.Status == ApplicationStatus.Approved)
                {
                    <div class="small text-success mt-2">
                        Approved on @a.ReviewedAt?.ToString("dd MMM yyyy"). If you can't see your host dashboard yet, log out and back in.
                    </div>
                }
                else if (a.Status == ApplicationStatus.Rejected)
                {
                    <div class="small text-danger mt-2">
                        Rejected@(string.IsNullOrWhiteSpace(a.RejectionReason) ? "." : ": " + a.RejectionReason)
                    </div>
                }
            </div>
        }
    }
</div>