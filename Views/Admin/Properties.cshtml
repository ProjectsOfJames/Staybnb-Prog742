@using System.Globalization
@model List<AdminPropertyRowVM>
@{
    ViewData["Title"] = "Properties";
    var rand = CultureInfo.GetCultureInfo("en-ZA");
}

<div class="text-muted small mb-2">Latest @Model.Count propert(ies)</div>

<div class="sb-panel p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr><th></th><th>Property</th><th>Host</th><th>Price / night</th><th>Bookings</th><th>Application</th><th>Listing</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td style="width:70px">
                            @if (p.ImageUrl != null)
                            {
                                <img src="@p.ImageUrl" alt="" class="rounded-2" style="width:60px;height:44px;object-fit:cover" />
                            }
                        </td>
                        <td><div class="fw-semibold">@p.Title</div><div class="small text-muted"><i class="bi bi-geo-alt-fill"></i> @p.City</div></td>
                        <td class="small">@p.HostName</td>
                        <td>@p.PricePerNight.ToString("C0", rand)</td>
                        <td>@p.BookingCount</td>
                        <td><partial name="_StatusBadge" model="p.ApplicationStatus.ToString()" /></td>
                        <td><partial name="_StatusBadge" model='p.IsActive ? "Active" : "Inactive"' /></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No properties yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>