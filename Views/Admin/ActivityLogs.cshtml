@model ActivityLogPageVM
@{
    ViewData["Title"] = "Activity Logs";
    var types = Enum.GetNames(typeof(ActivityType));

    string PageUrl(int page) =>
        "/Admin/ActivityLogs?q=" + Uri.EscapeDataString(Model.Search ?? "")
        + "&type=" + Uri.EscapeDataString(Model.Type ?? "")
        + "&from=" + (Model.From?.ToString("yyyy-MM-dd") ?? "")
        + "&to=" + (Model.To?.ToString("yyyy-MM-dd") ?? "")
        + "&page=" + page;

    string BadgeClass(ActivityType t) => t switch
    {
        ActivityType.RoleChange => "sb-badge-danger",
        ActivityType.ApplicationSubmitted or ActivityType.ApplicationDecision => "sb-badge-info",
        ActivityType.BookingStatusChange => "sb-badge-warning",
        ActivityType.CheckIn or ActivityType.Registration => "sb-badge-success",
        _ => "sb-badge-neutral"
    };
}

<form method="get" class="sb-panel mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-lg-4">
            <label class="form-label small text-muted mb-1" for="q">Search</label>
            <input id="q" name="q" type="search" class="form-control" placeholder="User, email or action" value="@Model.Search" />
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small text-muted mb-1" for="type">Type</label>
            <select id="type" name="type" class="form-select">
                <option value="">All types</option>
                @foreach (var t in types)
                {
                    <option value="@t" selected="@(Model.Type == t)">@t</option>
                }
            </select>
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small text-muted mb-1" for="from">From</label>
            <input id="from" name="from" type="date" class="form-control" value="@Model.From?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-lg-2">
            <label class="form-label small text-muted mb-1" for="to">To</label>
            <input id="to" name="to" type="date" class="form-control" value="@Model.To?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-6 col-lg-auto d-flex gap-2">
            <button type="submit" class="btn btn-danger">Filter</button>
            <a href="/Admin/ActivityLogs" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

<div class="text-muted small mb-2">@Model.TotalCount entr@(Model.TotalCount == 1 ? "y" : "ies")</div>

<div class="sb-panel p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr><th>When</th><th>User</th><th>Action</th><th>Type</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td class="small text-nowrap">@r.Date.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</td>
                        <td>
                            <div class="fw-semibold">@r.UserName</div>
                            <div class="small text-muted">@r.Email</div>
                        </td>
                        <td class="small">@r.Action</td>
                        <td><span class="sb-badge @BadgeClass(r.Type)">@r.Type</span></td>
                    </tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">No activity matches those filters.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="d-flex justify-content-between align-items-center mt-3">
        <a class="btn btn-sm btn-outline-secondary @(Model.Page == 1 ? "disabled" : "")" href="@PageUrl(Model.Page - 1)">Previous</a>
        <span class="small text-muted">Page @Model.Page of @Model.TotalPages</span>
        <a class="btn btn-sm btn-outline-secondary @(Model.Page == Model.TotalPages ? "disabled" : "")" href="@PageUrl(Model.Page + 1)">Next</a>
    </nav>
}