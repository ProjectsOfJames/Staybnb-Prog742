@using System.Globalization
@model List<BookingRowVM>
@{
    ViewData["Title"] = "Bookings";
    var rand = CultureInfo.GetCultureInfo("en-ZA");
}

<div class="text-muted small mb-2">Latest @Model.Count booking(s)</div>

<div class="sb-panel p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr><th>#</th><th>Guest</th><th>Property</th><th>Dates</th><th>Guests</th><th>Total</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td class="small text-muted">@b.Id</td>
                        <td><div class="fw-semibold">@b.GuestName</div><div class="small text-muted">@b.GuestEmail</div></td>
                        <td>@b.PropertyTitle</td>
                        <td class="small">@b.CheckInDate.ToString("dd MMM") &ndash; @b.CheckOutDate.ToString("dd MMM yyyy")</td>
                        <td>@b.NumberOfGuests</td>
                        <td>@b.TotalPrice.ToString("C0", rand)</td>
                        <td><partial name="_StatusBadge" model="b.Status.ToString()" /></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No bookings yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>