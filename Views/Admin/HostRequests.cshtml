@using System.Globalization
@model HostRequestsVM
@{
    ViewData["Title"] = "Host Requests";
    var rand = CultureInfo.GetCultureInfo("en-ZA");
    var tabs = new[] { "Pending", "Approved", "Rejected", "All" };
}

<partial name="_Alerts" />

<ul class="nav nav-pills mb-3">
    @foreach (var t in tabs)
    {
        <li class="nav-item">
            <a class="nav-link @(Model.Status == t ? "active" : "")"
               style="@(Model.Status == t ? "background:var(--sb-primary)" : "color:var(--sb-ink)")"
               href="/Admin/HostRequests?status=@t">@t</a>
        </li>
    }
</ul>

@if (!Model.Rows.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-inbox fs-1"></i>
        <p class="mt-2">No @(Model.Status == "All" ? "" : Model.Status.ToLower() + " ")applications.</p>
    </div>
}
else
{
    <div class="sb-panel p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Applicant</th><th>Property</th><th>Price / night</th><th>Applied</th><th>Status</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Rows)
                    {
                        <tr>
                            <td><div class="fw-semibold">@a.Applicant</div><div class="small text-muted">@a.Email</div></td>
                            <td><div>@a.PropertyTitle</div><div class="small text-muted"><i class="bi bi-geo-alt-fill"></i> @a.City</div></td>
                            <td>@a.PricePerNight.ToString("C0", rand)</td>
                            <td class="small">@a.Date.ToString("yyyy-MM-dd")</td>
                            <td><partial name="_StatusBadge" model="a.Status.ToString()" /></td>
                            <td class="text-end">
                                <a href="/Admin/HostRequestDetails/@a.Id" class="btn btn-sm @(a.Status == ApplicationStatus.Pending ? "btn-danger" : "btn-outline-secondary")">
                                    @(a.Status == ApplicationStatus.Pending ? "Review" : "View")
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}