@using System.Globalization
@model AdminDashboardVM
@{
    ViewData["Title"] = "Dashboard Overview";
    var rand = CultureInfo.GetCultureInfo("en-ZA");
}

<partial name="_Alerts" />

<div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">
    <div class="col"><div class="sb-stat"><div class="sb-stat-label">Total Users</div><div class="sb-stat-value">@Model.TotalUsers</div><div class="small text-success">Registered accounts</div></div></div>
    <div class="col">
        <a href="/Admin/HostRequests" class="text-decoration-none">
            <div class="sb-stat"><div class="sb-stat-label">Pending Host Apps</div><div class="sb-stat-value text-warning">@Model.PendingHostApps</div><div class="small text-success">Require review</div></div>
        </a>
    </div>
    <div class="col"><div class="sb-stat"><div class="sb-stat-label">Active Properties</div><div class="sb-stat-value">@Model.ActiveProperties</div><div class="small text-success">Listings available</div></div></div>
    <div class="col"><div class="sb-stat"><div class="sb-stat-label">Platform Revenue</div><div class="sb-stat-value">@Model.PlatformRevenue.ToString("C0", rand)</div><div class="small text-success">Service fees earned</div></div></div>
    <div class="col"><div class="sb-stat"><div class="sb-stat-label">Total Bookings</div><div class="sb-stat-value">@Model.TotalBookings</div><div class="small text-success">@Model.PendingBookings pending</div></div></div>
    <div class="col"><div class="sb-stat"><div class="sb-stat-label">Booking Volume</div><div class="sb-stat-value">@Model.BookingVolume.ToString("C0", rand)</div><div class="small text-success">Confirmed bookings</div></div></div>
    <div class="col"><div class="sb-stat"><div class="sb-stat-label">Approved Hosts</div><div class="sb-stat-value">@Model.ApprovedHosts</div><div class="small text-success">Active hosts</div></div></div>
</div>

<div class="sb-panel mb-4 p-0 overflow-hidden">
    <div class="p-3 fw-bold">Recent Activity</div>
    @if (!Model.RecentActivity.Any())
    {
        <div class="px-3 pb-3 text-muted small">No activity recorded yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light"><tr><th>User</th><th>Action</th><th>Type</th><th>Date</th></tr></thead>
                <tbody>
                    @foreach (var a in Model.RecentActivity)
                    {
                        <tr>
                            <td><div class="fw-semibold">@a.UserName</div><div class="small text-muted">@a.Email</div></td>
                            <td class="small">@a.Action</td>
                            <td><span class="sb-badge sb-badge-neutral">@a.Type</span></td>
                            <td class="small">@a.Date.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="sb-panel p-0 overflow-hidden">
            <div class="d-flex justify-content-between p-3">
                <span class="fw-bold">Recent Host Applications</span>
                <a href="/Admin/HostRequests?status=All" class="small">View all</a>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light"><tr><th>Applicant</th><th>Date</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var a in Model.RecentApplications)
                        {
                            <tr>
                                <td><div class="fw-semibold">@a.Applicant</div><div class="small text-muted">@a.PropertyTitle</div></td>
                                <td class="small">@a.Date.ToString("yyyy-MM-dd")</td>
                                <td><partial name="_StatusBadge" model="a.Status.ToString()" /></td>
                                <td class="text-end"><a href="/Admin/HostRequestDetails/@a.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="sb-panel p-0 overflow-hidden">
            <div class="d-flex justify-content-between p-3">
                <span class="fw-bold">Recent Bookings</span>
                <a href="/Admin/Bookings" class="small">View all</a>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light"><tr><th>Guest</th><th>Dates</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var b in Model.RecentBookings)
                        {
                            <tr>
                                <td><div class="fw-semibold">@b.GuestName</div><div class="small text-muted">@b.PropertyTitle</div></td>
                                <td class="small">@b.CheckInDate.ToString("dd MMM") &ndash; @b.CheckOutDate.ToString("dd MMM")</td>
                                <td><partial name="_StatusBadge" model="b.Status.ToString()" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>