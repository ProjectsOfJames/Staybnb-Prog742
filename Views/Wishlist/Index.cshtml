@model List<PropertyCardVM>
@{
    ViewData["Title"] = "Wishlist";
}

<div class="container-xxl py-4">
    <h1 class="h3 fw-bold mb-3">Wishlist</h1>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-heart fs-1"></i>
            <p class="mt-2">You haven't saved any stays yet.</p>
            <a href="/Properties" class="btn btn-danger">Explore stays</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-4">
            @foreach (var p in Model)
            {
                <div class="col"><partial name="_PropertyCard" model="p" /></div>
            }
        </div>
    }
</div>