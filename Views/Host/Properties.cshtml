@using System.Globalization
@model List<HostPropertyRowVM>
@{
    ViewData["Title"] = "My Properties";
    var rand = CultureInfo.GetCultureInfo("en-ZA");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count listing(s)</p>
    <a href="/HostApplication/Create" class="btn btn-danger btn-sm"><i class="bi bi-plus-lg"></i> Add property</a>
</div>

@foreach (var p in Model)
{
    <div class="sb-panel mb-3">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-3 col-lg-2">
                <img src="@p.ImageUrl" alt="@p.Title" class="w-100 rounded-3" style="height:110px;object-fit:cover" />
            </div>
            <div class="col">
                <div class="d-flex justify-content-between flex-wrap gap-2">
                    <div>
                        <div class="fw-semibold">@p.Title</div>
                        <div class="small text-muted"><i class="bi bi-geo-alt-fill"></i> @p.City</div>
                    </div>
                    <div class="fw-bold">@p.PricePerNight.ToString("C0", rand) <span class="small fw-normal text-muted">/night</span></div>
                </div>
                <div class="small text-muted mt-2">
                    @p.MaxGuests guests &middot; @p.Bedrooms bedrooms &middot; @p.Beds beds &middot; @p.Bathrooms bathrooms
                </div>
                <div class="d-flex flex-wrap gap-2 mt-2 align-items-center">
                    <span class="sb-badge sb-badge-neutral">@p.PropertyType</span>
                    <partial name="_StatusBadge" model='p.IsActive ? "Active" : "Inactive"' />
                    <span class="small text-muted ms-1">@p.BookingCount booking(s) &middot; @p.ReviewCount reviews</span>
                </div>
            </div>
            <div class="col-12 col-lg-auto d-flex gap-2">
                <button class="btn btn-sm btn-outline-secondary" disabled><i class="bi bi-eye"></i> View</button>
                <button class="btn btn-sm btn-outline-secondary" disabled><i class="bi bi-pencil"></i> Edit</button>
                <button class="btn btn-sm @(p.IsActive ? "btn-danger" : "btn-outline-success")" disabled>
                    @(p.IsActive ? "Deactivate" : "Activate")
                </button>
            </div>
        </div>
    </div>
}

<div class="text-muted small">The Activate / Deactivate toggle is wired later</div>