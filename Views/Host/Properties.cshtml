@using System.Globalization
@model List<HostPropertyRowVM>
@{
    ViewData["Title"] = "My Properties";
    var rand = CultureInfo.GetCultureInfo("en-ZA");
}

<partial name="_Alerts" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count listing(s)</p>
    <a href="/HostApplication/Create" class="btn btn-danger btn-sm"><i class="bi bi-plus-lg"></i> Add property</a>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-house fs-1"></i>
        <p class="mt-2">You don't have any properties yet.</p>
    </div>
}

@foreach (var p in Model)
{
    <div class="sb-panel mb-3">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-3 col-lg-2">
                @if (p.ImageUrl != null)
                {
                    <img src="@p.ImageUrl" alt="@p.Title" class="w-100 rounded-3" style="height:110px;object-fit:cover" />
                }
            </div>
            <div class="col">
                <div class="d-flex justify-content-between flex-wrap gap-2">
                    <div>
                        <div class="fw-semibold">@p.Title</div>
                        <div class="small text-muted"><i class="bi bi-geo-alt-fill"></i> @p.City</div>
                    </div>
                    <div class="fw-bold">@p.PricePerNight.ToString("C0", rand) <span class="small fw-normal text-muted">/night</span></div>
                </div>
                <div class="small text-muted mt-2">
                    @p.MaxGuests guests &middot; @p.Bedrooms bedrooms &middot; @p.Beds beds &middot; @p.Bathrooms bathrooms
                </div>
                <div class="d-flex flex-wrap gap-2 mt-2 align-items-center">
                    <span class="sb-badge sb-badge-neutral">@p.PropertyType</span>
                    @if (p.CanToggle)
                    {
                        <partial name="_StatusBadge" model='p.IsActive ? "Active" : "Inactive"' />
                    }
                    else if (p.ApplicationStatus == ApplicationStatus.Pending)
                    {
                        <span class="sb-badge sb-badge-warning">Pending approval</span>
                    }
                    else
                    {
                        <span class="sb-badge sb-badge-danger">Application rejected</span>
                    }
                    <span class="small text-muted ms-1">@p.BookingCount booking(s) &middot; @p.ReviewCount review(s)</span>
                </div>
            </div>
            <div class="col-12 col-lg-auto d-flex flex-wrap gap-2">
                <a href="/Host/EditProperty/@p.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i> Edit</a>
                <a href="/Host/ConfigureCheckIn/@p.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-list-check"></i> Check-in rules</a>
                @if (p.CanToggle)
                {
                    <form asp-action="ToggleActive" asp-route-id="@p.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm @(p.IsActive ? "btn-danger" : "btn-outline-success")">
                            @(p.IsActive ? "Deactivate" : "Activate")
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
}